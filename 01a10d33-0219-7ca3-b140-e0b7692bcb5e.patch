option>Training</option><option>Case Report</option><option>Incident Communication</option><option>Certificate</option><option>Audit</option><option>Inspection</option><option>Daily Management</option></select><span class=\"case-result-count\" id=\"epLogMatches\">0 shown</span></div>\n              <div class=\"table-wrap\"><table class=\"ep-log-table\"><thead><tr><th>Date</th><th>Record Type</th><th>Reference</th><th>Details</th><th>Status</th></tr></thead><tbody id=\"epLogsBody\"></tbody></table><div class=\"ep-empty hidden\" id=\"epLogsEmpty\">No linked records match the current search.</div></div>\n            </section>\n          </div>\n        </section>\n      </main>\n      <main class=\"page hidden\" id=\"caseManagementPage\">\n        <section class=\"page-heading\">\n          <div class=\"heading-left\"><div class=\"heading-icon\"><svg class=\"icon\"><use href=\"#i-briefcase\"/></svg></div><div><h1>Case Management</h1><p class=\"page-subtitle\">Review, manage and export reports submitted from your employee-facing portal</p></div></div><div class=\"heading-actions\"><button type=\"button\" class=\"btn btn-primary\" id=\"caseNewReport\"><svg class=\"icon\"><use href=\"#i-plus\"/></svg>Direct Data Entry</button></div>\n        </section>\n        <div class=\"case-source-note\"><svg class=\"icon\"><use href=\"#i-message\"/></svg><div class=\"case-source-copy\"><strong>Employee Front Page Reports</strong><small>Central inbox for seven report types. Live portal sync is not connected in this demo yet.</small></div><span class=\"case-demo-badge\"><svg class=\"icon\"><use href=\"#i-alert\"/></svg>Sample demo records</span></div>\n        <section class=\"case-summary-grid\" aria-label=\"Case report summary\">\n          <article class=\"stat-card\"><div class=\"stat-icon stat-blue\"><svg class=\"icon\"><use href=\"#i-clipboard\"/></svg></div><div class=\"stat-copy\"><div class=\"stat-label\">Total Reports</div><div class=\"stat-value\" id=\"caseTotalReports\">