+-- ======================================================================
+-- 4/6  Short site code (WBD)
+-- source: supabase/migrations/202610060004_site_code.sql
+-- ======================================================================
+
+-- Short display code for a site, shown next to the name in the app header (e.g. 'WBD'
+-- for West Bokaro). The sheet-backed path reads it from SAFEX_EMPLOYEE_MASTER_SITE_CODE;
+-- this column is how the Supabase-backed path carries the same thing.
+--
+-- Additive and idempotent. No RLS change is required: public.sites is granted table-wide
+-- to authenticated (see supabase/sql/02_rls.sql), and a site code is not personal data.
+
+alter table public.sites add column if not exists code text;
+
+comment on column public.sites.code is
