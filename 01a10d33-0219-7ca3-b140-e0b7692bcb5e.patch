ePrefixes={'Near Miss':'NM','Safety Observations':'SO','Hazard':'HZ','Feedback':'FB','Suggestions':'SG','Speak Up':'SP','Grievances':'GR'};\n      function openDirectCaseEntry(){\n        const catOpts=caseCategories.map(c=>`<option>${escapeHtml(c)}</option>`).join('');\n        const body=`<div class=\"case-edit-grid\"><div class=\"case-edit-field\"><label for=\"dcCategory\">Report type</label><select id=\"dcCategory\">${catOpts}</select></div><div class=\"case-edit-field\"><label for=\"dcPriority\">Priority</label><select id=\"dcPriority\"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select></div><div class=\"case-edit-field wide\"><label for=\"dcTitle\">Title <span class=\"required\">*</span></label><input id=\"dcTitle\" maxlength=\"140\" placeholder=\"Short summary of the report\"/></div><div class=\"case-edit-field\"><label for=\"dcLocation\">Location <span class=\"required\">*</span></label><input id=\"dcLocation\" placeholder=\"e.g. Scrap Yard · Loading Bay\"/></div><div class=\"case-edit-field\"><label for=\"dcDate\">Date</label><input id=\"dcDate\" type=\"date\" value=\"2026-10-05\"/></div><div class=\"case-edit-field\"><label for=\"dcReporter\">Reported by</label><input id=\"dcReporter\" placeholder=\"Employee name\"/></div><div class=\"case-edit-field\"><label for=\"dcDept\">Department</label><input id=\"dcDept\" placeholder=\"Department\"/></div><div class=\"case-edit-field wide\"><label style=\"display:flex;gap:6px;align-items:center\"><input id=\"dcAnon\" type=\"checkbox\" style=\"width:auto;height:auto;margin:0\"/> Submit anonymously / confidentially</label></div><div class=\"case-edit-field wide\"><label for=\"dcDesc\">Report details</label><textarea id=\"dcDesc\" placeholder=\"What happened or what was observed?\"></textarea></div><div class=\"case-edit-field wide\"><label for=\"dcImmediate\">Immediate action taken</label><textarea id=\"dcImmediate\"></textarea></div><div class=\"case-edit-field wide\"><label for=\"dcFollow\">Recommended follow-up</label><textarea id=\"dcFollow\"></textarea></div></div>`;\n        openModal('Direct Data Entry · New Report',body,'Submit report',f=>{\n          const title=f.querySelector('#dcTitle').value.trim(),location=f.querySelector('#dcLocation').value.trim();\n          if(!title||!location){toast('Add a title and location.');return}\n          const category=f.querySelector('#dcCategory').value,pre=casePrefixes[category],yr='2026';\n          const next=Math.max(0,...caseReports.filter(r=>r.id.startsWith(pre+'-')).map(r=>parseInt(r.id.split('-')[2],10)||0))+1;\n          const anon=f.querySelector('#dcAnon').checked;\n          const rec={id:`${pre}-${yr}-${String(next).padStart(3,'0')}`,category,title,location,reporter:anon?'Anonymous':(f.querySelector('#dcReporter').value.trim()||'Not stated'),department:anon?'Confidential':(f.querySelector('#dcDept').value.trim()||'—'),date:f.querySelector('#dcDate').value||'2026-10-05',priority:f.querySelector('#dcPriority').value,status:'Open',owner:'Unassigned',anonymous:anon,direct:true,description:f.querySelector('#dcDesc').value.trim(),immediateAction:f.querySelector('#dcImmediate').value.trim(),followUp:f.querySelector('#dcFollow').value.trim()};\n          caseReports.unshift(rec);closeModal();showCaseManagement('All Reports',$$('.nav-link').find(l=>l.dataset.nav==='Case Management'));toast(`${rec.id} submitted via Direct Data Entry.`);\n        });\n        modalCard.classList.add('case-detail-modal');\n        const cat=modalBody.querySelector('#dcCategory'),anon=modalBody.querySelector('#dcAnon');\n        cat.addEventListener('change',()=>{if(['Speak Up','Grievances'].includes(cat.value))anon.checked=true});\n      }\n      $('#caseNewReport').addEventListener('click',openDirectCaseEntry);\n\n      function inMonth(id,date){const v=document.getElementById(id)?.value;return !v||String(date||'').slice(0,7)===v}\n      function monthOptionsHtml(){const o=['<option value=\