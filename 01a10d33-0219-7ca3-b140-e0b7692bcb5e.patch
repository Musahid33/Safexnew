n        {id:'DML-2026-012',date:'2026-10-02',site:'Workshop',shift:'Day',lead:'Rakesh Kumar',focus:'Housekeeping around maintenance benches',action:'Clear the aisle and return unused tools to marked storage.',owner:'Workshop Lead',status:'Closed'}\n      ];\n      let dailyLogSequence=15;\n      const defaultWorkspaceSettings={defaultSite:'West Bokaro',dateFormat:'DD MMM YYYY',landingPage:'Audit & Inspection',language:'English',systemAlerts:true,weeklySummary:false,compactTables:false};\n      let workspaceSettings={...defaultWorkspaceSettings};\n      const csvCell=value=>{const text=String(value??''),first=text.trimStart()[0],safe=['=','+','-','@'].includes(first)?`'${text}`:text;return `\"${safe.replaceAll('\"','\"\"')}\"`};\n      function csvFromRows(rows){return rows.map(row=>row.map(csvCell).join(',')).join('\\r\\n')}\n      function getPublishedWorkspaceContentCount(){return communications.filter(item=>['Published','Broadcast'].includes(item.status)).length+libraryDocuments.filter(item=>item.status==='Published').length}\n      function renderSafetyDashboard(){\n        $('#dashTrainingCount').textContent=$('#totalTrainings').textContent||'0';$('#dashCaseCount').textContent=fmt(caseReports.length);$('#dashAiCount').textContent=fmt(auditRecords.length+inspectionRecords.length);$('#dashPublishedCount').textContent=fmt(getPublishedWorkspaceContentCount());\n        const activity=[...caseReports.map(item=>({id:item.id,title:item.title,module:'Case Management',site:item.location,date:item.date,status:item.status})),...auditRecords.map(item=>({id:item.id,title:item.title,module:`Audit · ${item.auditType}`,site:item.site,date:item.date,status:item.status})),...inspectionRecords.map(item=>({id:item.id,title:item.asset,module:`Inspection · ${item.inspectionType}`,site:item.site,date:item.date,status:item.status})),...communications.filter(item=>['Published','Broadcast'].includes(item.status)).map(item=>({id:item.id,title:item.title,module:'Communications',site:item