+++ b/scripts/build-supabase-setup.mjs
@@ -0,0 +1,58 @@
+/**
+ * Concatenate the Supabase schema into one paste-able file.
+ *
+ * Applying five files in the right order through a web SQL editor is exactly the kind of
+ * step that gets done in the wrong order once and then debugged for an hour. This emits
+ * supabase/setup.sql: the same statements, in the only order that works, with banners so
+ * a partial run is obvious.
+ *
+ * Every source file is idempotent (create ... if not exists, drop policy if exists), so
+ * re-running setup.sql is safe.
+ *
+ *   npm run supabase:setup
+ */
+import { readFile, writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+
+/** Order matters: tables, then the columns later migrations add, then RLS, then the gate test. */
+const FILES = [
+  ['supabase/migrations/202610030001_initial_safex.sql', 'Tables, indexes and foreign keys'],
+  ['supabase/migrations/202610030002_offline_report_sync.sql', 'Offline report sync'],
+  ['supabase/migrations/202610050003_employee_master_sync.sql', 'Employee master columns and import runs'],
+  ['supabase/migrations/202610060004_site_code.sql', 'Short site code (WBD)'],
+  ['supabase/sql/02_rls.sql', 'Row level security — the part that keeps tenants apart'],
+  ['supabase/sql/99_gate_test.sql', 'Verification. Read the output: every row must say PASS']
+];
+
+const banner = (n, total, label, path) => `
+-- ======================================================================
+-- ${n}/${total}  ${label}
+-- source: ${path}
+-- ======================================================================
+`;
+
+const parts = [`-- Safex — complete Supabase setup
+--
+-- Generated by scripts/build-supabase-setup.mjs. Do not edit by hand; edit the files
+-- under supabase/migrations or supabase/sql and re-run \`npm run supabase:setup\`.
+--
+-- How to apply: open the Supabase SQL editor, paste this whole file, Run. It is
+-- idempotent, so running it twice is harmless.
+--
+-- The last section is a verification suite. It does not change anything; it prints a
+-- row per check. If any row is not PASS, stop and fix it before importing the roster —
+-- the checks that fail loudest are the ones that would otherwise leak one tenant's
+-- employees to another.
+`];
+
+for (const [index, [path, label]] of FILES.entries()) {
+  const sql = await readFile(join(root, path), 'utf8');
+  parts.push(banner(index + 1, FILES.length, label, path), sql.trimEnd(), '\n');
+}
+
+const out = join(root, 'supabase/setup.sql');
+await writeFile(out, parts.join('\n'), 'utf8');
+console.log(`supabase/setup.sql written — ${FILES.length} files, ${parts.join('\n').split('\n').length} lines`);
