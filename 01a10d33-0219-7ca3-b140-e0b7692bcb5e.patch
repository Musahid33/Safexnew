pdated.`);\n        });\n        modalCard.classList.add('case-detail-modal');\n      }\n      function caseStandardFormat(record){return {format_version:'1.0',system:'SafetyOS',report_id:record.id,category:record.category,title:record.title,description:record.description||'',location:record.location,reported_by:record.anonymous?'Anonymous':record.reporter,department:record.anonymous?'Confidential':record.department,submitted_at:record.date,priority:record.priority,status:record.status,assigned_to:record.owner||'Unassigned',immediate_action:record.immediateAction||'',recommended_follow_up:record.followUp||'',is_anonymous:Boolean(record.anonymous)}}\n      async function exportSingleCaseReport(id){\n        const record=caseReports.find(item=>item.id===id);if(!record)return;\n        const filename=`safetyos-${caseSlug(record.id)}-standard.json`,content=JSON.stringify({...caseStandardFormat(record),exported_at:new Date().toISOString()},null,2);\n        if(typeof window.showSaveFilePicker==='function'){\n          try{const handle=await window.showSaveFilePicker({suggestedName:filename,types:[{description:'SafetyOS standard case report',accept:{'application/json':['.json']}}]});const writable=await handle.createWritable();await writable.write(content);await writable.close();toast(`${record.id} exported as standard JSON.`);return}\n          catch(error){if(error?.name==='AbortError')return}\n        }\n        downloadFile(filename,content,'application/json;charset=utf-8');toast(`${record.id} exported. Choose your designated folder in the save dialog or Downloads.`);\n      }\n      const commSectionNames=['Safety Alerts','Circulars & Notices','Upcoming Events'];\n      const safetyAlertTypeNames=['LTI','First Aid','Fatal','Red Risk','Medical Case','Burn Injury','Property Damage','Other'];\n      let activeCommCategory='All Communications',selectedCommunicationFiles=[];\n      const communications=[\n        {id:'SA-2026-021',section:'Safety Alerts',alertType:'LTI',t