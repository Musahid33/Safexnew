ial follow-up.',followUp:'Review roster records and respond through the approved grievance process.'}\n      ];\n      function caseSlug(value){return String(value||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}\n      function formatCaseDate(value){const date=new Date(`${value}T00:00:00`);return Number.isNaN(date.getTime())?String(value||'—'):new Intl.DateTimeFormat('en-IN',{day:'2-digit',month:'short',year:'numeric'}).format(date)}\n      function getCaseScopeRecords(){return caseReports.filter(record=>(activeCaseCategory==='All Reports'||record.category===activeCaseCategory)&&inMonth('caseMonth',record.date))}\n      function getFilteredCaseReports(){\n        const query=$('#caseSearch').value.trim().toLowerCase(),status=$('#caseStatusFilter').value,priority=$('#casePriorityFilter').value;\n        return getCaseScopeRecords().filter(record=>{\n          const reporter=record.anonymous?'Anonymous':record.reporter;\n          const searchable=[record.id,record.category,record.title,record.location,reporter,record.department,record.description,record.immediateAction,record.followUp,record.owner].join(' ').toLowerCase();\n          return (!query||searchable.includes(query))&&(!status||record.status===status)&&(!priority||record.priority===priority);\n        }).sort((a,b)=>b.date.localeCompare(a.date));\n      }\n      function renderCaseManagement(){\n        const scope=getCaseScopeRecords(),filtered=getFilteredCaseReports();\n        const open=scope.filter(record=>record.status==='Open').length;\n        const inProgress=scope.filter(record=>record.status==='In Review'||record.status==='In Progress').length;\n        const resolved=scope.filter(record=>record.status==='Resolved'||record.status==='Closed').length;\n        $('#caseTotalReports').textContent=fmt(scope.length);$('#caseOpenReports').textContent=fmt(open);$('#caseInProgressReports').textContent=fmt(inProgress);$('#caseResolvedReports').textContent=fmt(resolved);\n        $('#cas