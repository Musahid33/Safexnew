+/**
+ * Life Saving Rules, as issued by the site operator.
+ *
+ * Two deliberate decisions about this file:
+ *
+ * 1. **The text is verbatim and never translated.** Everything else in the app goes
+ *    through `T()`, but these do not. A Life Saving Rule is the wording a worker is
+ *    disciplined against and, in an incident, the wording an investigation quotes. A
+ *    machine-translated "2 metres or more" that drifts into "2 metres or less" is not a
+ *    typo, it is a fall. If these are ever needed in Hindi they must arrive as an
+ *    approved translation from the issuing authority, added here as a separate rule set.
+ *
+ * 2. **Rules are per site, not global.** OMQ, West Bokaro and FAMD share one set today;
+ *    another location may have its own. `lifeSavingRulesFor` returns null for a site
+ *    with nothing published, and the UI says so rather than showing another site's rules.
+ */
+
+/** Maps to a Lucide icon in the UI. Kept as a key so this file stays free of React. */
+export type LifeSavingRuleIcon =
+  | 'ppe' | 'rail' | 'control' | 'confined' | 'permit'
+  | 'hemm' | 'material' | 'flammable' | 'height' | 'substance';
+
+export type LifeSavingRule = {
+  number: number;
+  title: string;
+  body: string;
+  icon: LifeSavingRuleIcon;
+};
+
+export type LifeSavingRuleSet = {
+  /** The operator's own grouping, which may cover more locations than this app does. */
+  scope: string;
+  issuedBy: string;
+  intro: string;
+  rules: LifeSavingRule[];
+};
+
+const OMQ_WEST_BOKARO_FAMD: LifeSavingRuleSet = {
+  scope: 'OMQ, WEST BOKARO and FAMD',
+  issuedBy: 'Tata Steel',
+  intro: 'Rules designed to protect your life! Please respect and adhere to these rules.',
+  rules: [
+    {
+      number: 1,
+      icon: 'ppe',
+      title: 'Personal Protective Equipment (PPE)',
+      body: 'Do not work without mandatory Personal Protective Equipment.'
+    },
+    {
+      number: 2,
+      icon: 'rail',
+      title: 'Rail and Road Safety',
+      body: 'Do not use mobile phones at the workplace unless authorised. Follow traffic rules and keep a safe distance from moving wagons/ mobile equipment.'
+    },
+    {
+      number: 3,
+      icon: 'control',
+      title: 'Safety Control',
+      body: 'Obtain authorisation from designated person before overriding any safety control.'
+    },
+    {
+      number: 4,
+      icon: 'confined',
+      title: 'Confined Space',
+      body: 'Obtain authorisation before entry in Confined space.'
+    },
+    {
+      number: 5,
+      icon: 'permit',
+      title: 'Work Permit and Positive Isolation',
+      body: 'Obtain a work permit before start of work. Verify energy isolation before work begins and ensure LockOut-TagOut-TryOut (LOTOTO) is in place.'
+    },
+    {
+      number: 6,
+      icon: 'hemm',
+      title: 'Heavy Earth Moving Machinery (HEMM) / Blasting / Moving Machinery',
+      body: 'Maintain a safe distance from HEMM & Moving Machines. Blasting danger zone to be accessed only after proper authorisation. Mobile usage while operating machinery is strictly prohibited.'
+    },
+    {
+      number: 7,
+      icon: 'material',
+      title: 'Material Handling',
+      body: 'Follow standard for material handling and never stand below suspended load.'
+    },
+    {
+      number: 8,
+      icon: 'flammable',
+      title: 'Flammable and Toxic substances / Ferro Alloy Plant Operation',
+      body: 'Use gas detector in hazardous gas areas and follow safety standards when carrying out hot work in a flammable environment.'
+    },
+    {
+      number: 9,
+      icon: 'height',
+      title: 'Working at Height',
+      body: 'Use a full-body harness, anchored with rigid connection while working at height of 2 metres or more.'
+    },
+    {
+      number: 10,
+      icon: 'substance',
+      title: 'Alcohol and Drugs',
+      body: 'Do not drive or work under the influence of alcohol or drugs.'
+    }
+  ]
+};
+
+const RULE_SETS: Record<string, LifeSavingRuleSet> = {
+  wbd: OMQ_WEST_BOKARO_FAMD
+};
+
+/** Null when nothing is published for this site. Never falls back to another site's rules. */
+export function lifeSavingRulesFor(siteId: string | null | undefined): LifeSavingRuleSet | null {
+  if (!siteId) return null;
+  return RULE_SETS[siteId] ?? null;
+}
