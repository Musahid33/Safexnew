        <div class=\"ep-field\"><label for=\"epEmergencyMobile\">Emergency mobile</label><input id=\"epEmergencyMobile\" type=\"tel\" maxlength=\"20\" placeholder=\"Contact number\"/></div>\n                <div class=\"ep-field\"><label for=\"epLocation\">Site / location</label><input id=\"epLocation\" maxlength=\"80\" placeholder=\"Site or work location\"/></div>\n                <div class=\"ep-field full\"><label for=\"epAddress\">Address / personal details</label><textarea id=\"epAddress\" maxlength=\"500\" rows=\"2\" placeholder=\"Address or other relevant personal details\"></textarea></div>\n                <div class=\"ep-field full\"><label for=\"epNotes\">Additional notes</label><textarea id=\"epNotes\" maxlength=\"500\" rows=\"2\" placeholder=\"Optional profile notes\"></textarea></div>\n              </div>\n              <div class=\"ep-form-actions\"><button type=\"button\" class=\"btn btn-light\" id=\"epResetForm\">Reset form</button><button type=\"submit\" class=\"btn btn-primary\" id=\"epSubmit\">Save Employee</button></div>\n            </form>\n          </section>\n          <section class=\"panel ep-panel ep-directory-panel\">\n            <div class=\"ep-panel-heading\"><div><span class=\"eyebrow\">EMPLOYEE DIRECTORY</span><h2>Master Records</h2><p>Search by employee number, name, mobile, role or department.</p></div><span class=\"case-report-count\" id=\"epDirectoryCount\">0 employees</span></div>\n            <div class=\"ep-directory-toolbar\"><label class=\"ep-search\"><svg class=\"icon\"><use href=\"#i-search\"/></svg><input id=\"epDirectorySearch\" type=\"search\" placeholder=\"Search employee no, name, mobile...\" autocomplete=\"off\"/></label><select id=\"epDepartmentFilter\" aria-label=\"Filter employees by department\"><option value=\"\">All departments</option></select><span class=\"case-result-count\" id=\"epDirectoryMatches\">0 shown</span></div>\n            <div class=\"table-wrap\"><table class=\"ep-table\"><thead><tr><th>Emplo