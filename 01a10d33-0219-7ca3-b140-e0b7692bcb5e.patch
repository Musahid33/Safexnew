Communications(){\n        const query=$('#commSearch').value.trim().toLowerCase(),status=$('#commStatusFilter').value;\n        return getCommunicationScope().filter(item=>[item.id,item.section,commSubType(item),item.title,item.message,item.audience].join(' ').toLowerCase().includes(query)&&(!status||item.status===status)&&inMonth('commMonth',item.eventDate||item.releasedAt||item.createdAt)).sort((a,b)=>(b.createdAt||'').localeCompare(a.createdAt||''));\n      }\n      function renderCommunicationAttachmentTags(attachments){return (attachments||[]).length?attachments.map(file=>`<span class=\"comms-attachment-tag\"><svg class=\"icon\"><use href=\"#${/\\.pdf$/i.test(file.name)?'i-pdf':'i-file'}\"/></svg>${escapeHtml(file.name)}</span>`).join(''):'<span>—</span>'}\n      function renderUserFrontPagePreview(){\n        const live=communications.filter(isCommunicationLive).sort((a,b)=>(b.releasedAt||b.createdAt).localeCompare(a.releasedAt||a.createdAt));\n        const sections=[\n          {name:'Safety Alerts',style:'alerts',icon:'i-bell',subtitle:'Incident alerts, controls & lessons learned',action:'DEMO'},\n          {name:'Circulars & Notices',style:'circulars',icon:'i-file',subtitle:'Browse all circulars and notices',action:'See all ›'},\n          {name:'Upcoming Events',style:'events',icon:'i-calendar',subtitle:'Upcoming safety events',action:'View All ›'}\n        ];\n        $('#employeeFrontPagePreview').innerHTML=sections.map(section=>{\n          const items=live.filter(item=>item.section===section.name).sort((a,b)=>section.name==='Upcoming Events'?(a.eventDate||'').localeCompare(b.eventDate||''):(b.releasedAt||'').localeCompare(a.releasedAt||'')).slice(0,2);\n          const posts=items.length?items.map(item=>`<div class=\"comms-home-post\"><strong>${section.name==='Safety Alerts'?`<span class=\"alert-type\">${escapeHtml(item.alertType)} · </span>`:section.name==='Circulars & Notices'?`<span class=\"alert-type\">${escapeHtml(item.contentType)} · </span>`:'