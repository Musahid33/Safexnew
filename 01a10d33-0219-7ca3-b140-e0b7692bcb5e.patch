diff --git a/app/components/safetyos/SafetyOsApp.tsx b/app/components/safetyos/SafetyOsApp.tsx
new file mode 100644
index 0000000..bd49a10
--- /dev/null
+++ b/app/components/safetyos/SafetyOsApp.tsx
@@ -0,0 +1,254 @@
+'use client';
+
+import { useEffect, useRef, useState } from 'react';
+import '@/app/safetyos.css';
+import '@/app/safetyos-host.css';
+import { DESIGN_MARKUP } from './generated/markup';
+import { DESIGN_SCRIPT } from './generated/script';
+import type { Site } from '@/lib/types';
+
+/**
+ * Mounts the SafetyOS console exactly as designed.
+ *
+ * The design is a self-contained page: ~106 KB of CSS, ~139 KB of markup and ~252 KB of
+ * vanilla JS driving 18 screens, SVG charts, a form builder and CSV/report export. It
+ * runs here as its own code rather than as a hand-rewritten React translation — a
+ * translation of that surface would take weeks and would drift from the design the
+ * moment either side changed.
+ *
+ * Three things make that safe:
+ *  - the stylesheet is machine-scoped under `.sos`, so it cannot touch the worker app,
+ *  - the design's own script is already wrapped in an IIFE, so re-running it declares
+ *    nothing globally,
+ *  - listeners it attaches to document/window are recorded during execution and removed
+ *    on unmount, so leaving the console does not leave handlers pointing at dead nodes.
+ *
+ * Regenerate the three imported files with `npm run design:extract` after editing the
+ * design; never hand-edit them.
+ */
+
+type Props = {
+  sites: Site[];
+  selectedSiteId: string;
+  onExit: () => void;
+};
+
+type AdminEmployee = {
+  empNo: string;
+  name: string;
+  designation: string;
+  department: string | null;
+  siteId: string;
+  skillGrade: string | null;
+  mobile?: string | null;
+};
+
+/** Shape the design's own directory code expects. */
+type DesignEmployee = {
+  id: string;
+  name: string;
+  designation: string;
+  department: string;
+  mobile: string;
+  location: string;
+};
+
+declare global {
+  interface Window {
+    __SAFEX_EMPLOYEES__?: DesignEmployee[];
+  }
+}
+
+type Phase = 'loading' | 'ready' | 'locked' | 'unconfigured';
+
+export default function SafetyOsApp({ sites, selectedSiteId, onExit }: Props) {
+  const host = useRef<HTMLDivElement>(null);
+  const booted = useRef(false);
+  const [phase, setPhase] = useState<Phase>('loading');
+  const [username, setUsername] = useState('');
+  const [passcode, setPasscode] = useState('');
+  const [authError, setAuthError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [roster, setRoster] = useState<DesignEmployee[] | null>(null);
+
+  // 1. Decide whether the real employee master is available to this operator.
+  useEffect(() => {
+    let cancelled = false;
+
+    async function boot() {
+      let session: { configured: boolean; signedIn: boolean } | null = null;
+      try {
+        session = await (await fetch('/api/admin/session', { credentials: 'same-origin' })).json();
+      } catch {
+        session = null;
+      }
+      if (cancelled) return;
+
+      if (!session?.configured) { setPhase('unconfigured'); return; }
+      if (!session.signedIn) { setPhase('locked'); return; }
+
+      setRoster(await fetchRoster(sites));
+      if (!cancelled) setPhase('ready');
+    }
+
+    void boot();
+    return () => { cancelled = true; };
+  }, [sites]);
+
+  // 2. Inject the design once the decision is made. Separate effect so the markup is
+  //    only ever written after `phase` settles — the script runs on insertion and must
+  //    not see a half-built DOM.
+  useEffect(() => {
+    if (phase !== 'ready' && phase !== 'unconfigured') return;
+    const container = host.current;
+    if (!container || booted.current) return;
+    booted.current = true;
+
+    window.__SAFEX_EMPLOYEES__ = roster ?? undefined;
+    container.innerHTML = DESIGN_MARKUP;
+
+    // Record what the design attaches globally so unmount can take it back off.
+    const docAdd = document.addEventListener.bind(document);
+    const winAdd = window.addEventListener.bind(window);
+    const attached: { target: EventTarget; type: string; fn: EventListenerOrEventListenerObject; opts?: unknown }[] = [];
+    document.addEventListener = ((type: string, fn: EventListenerOrEventListenerObject, opts?: never) => {
+      attached.push({ target: document, type, fn, opts });
+      docAdd(type, fn, opts);
+    }) as typeof document.addEventListener;
+    window.addEventListener = ((type: string, fn: EventListenerOrEventListenerObject, opts?: never) => {
+      attached.push({ target: window, type, fn, opts });
+      winAdd(type, fn, opts);
+    }) as typeof window.addEventListener;
+
+    try {
+      const element = document.createElement('script');
+      element.textContent = DESIGN_SCRIPT;
+      container.appendChild(element);
+    } catch (error) {
+      console.error('SafetyOS console failed to start', error);
+    } finally {
+      document.addEventListener = docAdd as typeof document.addEventListener;
+      window.addEventListener = winAdd as typeof window.addEventListener;
+    }
+
+    return () => {
+      for (const entry of attached) {
+        entry.target.removeEventListener(entry.type, entry.fn, entry.opts as never);
+      }
+      delete window.__SAFEX_EMPLOYEES__;
+      container.innerHTML = '';
+      booted.current = false;
+    };
+  }, [phase, roster]);
+
+  async function unlock(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setBusy(true);
+    setAuthError('');
+    try {
+      const response = await fetch('/api/admin/session', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password: passcode })
+      });
+      const data = await response.json();
+      if (!response.ok || !data.ok) {
+        setAuthError(data.error ?? 'That user ID and password were not accepted.');
+        return;
+      }
+      setPasscode('');
+      setRoster(await fetchRoster(sites));
+      setPhase('ready');
+    } catch {
+      setAuthError('Sign-in failed. Check your connection and try again.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  if (phase === 'loading') {
+    return <div className="sos sos-gate"><p>Checking access…</p></div>;
+  }
+
+  if (phase === 'locked') {
+    return (
+      <div className="sos sos-gate">
+        <form onSubmit={unlock}>
+          <h2>Admin / HSE Manager / Safety Officer sign-in</h2>
+          <p>
+            One account covers all three. The console reads the live employee master, so
+            access is verified on the server rather than in the browser, and the session
+            lasts 8 hours.
+          </p>
+          <label htmlFor="sos-gate-username">User ID</label>
+          <input
+            id="sos-gate-username"
+            value={username}
+            onChange={(event) => setUsername(event.target.value)}
+            autoComplete="username"
+            required
+          />
+          <label htmlFor="sos-gate-passcode">Password</label>
+          <input
+            id="sos-gate-passcode"
+            type="password"
+            value={passcode}
+            onChange={(event) => setPasscode(event.target.value)}
+            autoComplete="current-password"
+            required
+          />
+          <button type="submit" disabled={busy || !username || !passcode}>
+            {busy ? 'Verifying…' : 'Open console'}
+          </button>
+          {authError && <p className="sos-gate-error" role="alert">{authError}</p>}
+          <button type="button" className="sos-gate-link" onClick={onExit}>Back to the app</button>
+        </form>
+      </div>
+    );
+  }
+
+  // `unconfigured` still renders the console — it simply runs on the design's own demo
+  // records, which is the right behaviour when no master is wired up yet.
+  return (
+    <>
+      {phase === 'unconfigured' && (
+        <div className="sos-demo-banner">
+          Demo records · set SAFEX_ADMIN_PASSCODE on the server to load the real employee master
+          <button type="button" onClick={onExit}>Exit</button>
+        </div>
+      )}
+      <div className="sos" ref={host} data-site={selectedSiteId} />
+    </>
+  );
+}
+
+async function fetchRoster(sites: Site[]): Promise<DesignEmployee[] | null> {
+  const collected: DesignEmployee[] = [];
+  const siteName = (id: string) => sites.find((site) => site.id === id)?.name ?? id;
+
+  // The API caps a page at 50; walk it so the console gets the whole directory.
+  for (let offset = 0; offset < 2000; offset += 50) {
+    let payload: { ok?: boolean; total?: number; employees?: AdminEmployee[] };
+    try {
+      const response = await fetch(`/api/admin/employees?limit=50&offset=${offset}`, { credentials: 'same-origin' });
+      payload = await response.json();
+    } catch {
+      return collected.length ? collected : null;
+    }
+    if (!payload?.ok || !payload.employees?.length) break;
+    for (const row of payload.employees) {
+      collected.push({
+        id: row.empNo,
+        name: row.name,
+        designation: row.designation || '',
+        department: row.department ?? '',
+        mobile: row.mobile ?? '',
+        location: siteName(row.siteId)
+      });
+    }
+    if (collected.length >= (payload.total ?? 0)) break;
+  }
+
+  return collected.length ? collected : null;
+}
