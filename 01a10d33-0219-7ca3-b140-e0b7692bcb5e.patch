diff --git a/app/safetyos-host.css b/app/safetyos-host.css
new file mode 100644
index 0000000..dc48f53
--- /dev/null
+++ b/app/safetyos-host.css
@@ -0,0 +1,82 @@
+/*
+ * Chrome the app wraps around the embedded SafetyOS console.
+ *
+ * Deliberately NOT in safetyos.css — that file is machine-generated from the design and
+ * regenerated wholesale by `npm run design:extract`, so anything hand-written there is
+ * lost. These rules are the host's own: the server-side sign-in gate and the demo banner.
+ */
+
+.sos-gate {
+  display: grid;
+  place-items: center;
+  min-height: 100vh;
+  padding: 24px;
+  background: #f3f7fc;
+}
+.sos-gate form {
+  display: grid;
+  gap: 9px;
+  width: 100%;
+  max-width: 330px;
+  padding: 22px;
+  border: 1px solid #e2e9f2;
+  border-radius: 13px;
+  background: #fff;
+  box-shadow: 0 3px 16px rgba(16, 42, 75, .07);
+}
+.sos-gate h2 { margin: 0; color: #15304f; font-size: 15px; }
+.sos-gate p { margin: 0; color: #70829a; font-size: 10px; line-height: 1.5; }
+.sos-gate label { color: #56677d; font-size: 9px; font-weight: 700; }
+.sos-gate input {
+  width: 100%;
+  min-height: 33px;
+  padding: 7px 9px;
+  border: 1px solid #dfe6ef;
+  border-radius: 6px;
+  font-size: 11px;
+  color: #34465e;
+}
+.sos-gate input:focus { outline: 0; border-color: #94b8ea; box-shadow: 0 0 0 2px rgba(40, 110, 205, .1); }
+.sos-gate button[type='submit'] {
+  min-height: 33px;
+  border: 0;
+  border-radius: 6px;
+  background: #1263df;
+  color: #fff;
+  font-size: 11px;
+  font-weight: 700;
+  cursor: pointer;
+}
+.sos-gate button[type='submit']:disabled { opacity: .5; cursor: not-allowed; }
+.sos-gate-error { color: #c42b36 !important; font-weight: 600; }
+.sos-gate-link {
+  border: 0;
+  background: none;
+  color: #70829a;
+  font-size: 10px;
+  text-decoration: underline;
+  cursor: pointer;
+}
+
+.sos-demo-banner {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 7px 13px;
+  background: #fff6e3;
+  border-bottom: 1px solid #f0dcb4;
+  color: #7d5f1c;
+  font-size: 10px;
+  font-weight: 600;
+}
+.sos-demo-banner button {
+  margin-left: auto;
+  padding: 3px 10px;
+  border: 1px solid #e2cb97;
+  border-radius: 999px;
+  background: #fff;
+  color: #7d5f1c;
+  font-size: 9px;
+  font-weight: 700;
+  cursor: pointer;
+}
