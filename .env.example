# Public browser configuration — safe to expose only these public values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Offline outbox sync stays disabled until tenant domains/sites, RLS/schema, private storage
# bucket and the database rate-limit function are verified in staging.
SAFEX_REPORT_SUBMISSIONS_ENABLED=false
SAFEX_REPORT_RATE_LIMIT_SALT=SET_A_LONG_RANDOM_SERVER_ONLY_SECRET

# ---------------------------------------------------------------------------------------
# Report sync (server-only). Requires a verified public.tenant_domains row for the host that
# serves the app, plus the storage bucket and rate-limit function from the migrations.
# See docs/report-sync.md for the activation checklist and the SQL to add a host.
# ---------------------------------------------------------------------------------------
# Leave false until the deployment has: service key, verified domain row, private bucket and
# the safex_consume_report_limit function. Reports queue on the device until this is true.
# SAFEX_REPORT_SUBMISSIONS_ENABLED and SAFEX_REPORT_RATE_LIMIT_SALT are declared above.

# ---------------------------------------------------------------------------------------
# Employee master (server-only). The roster is personal data: never commit it, never put
# any of these values behind a NEXT_PUBLIC_ prefix, and never return a full roster to a
# browser without admin authentication. Unconfigured/unreachable sources show unavailable.
#
# Use the published CSV endpoint in a real deployment...
SAFEX_EMPLOYEE_MASTER_CSV_URL=
# ...or a local CSV file for offline development / air-gapped environments.
SAFEX_EMPLOYEE_MASTER_FILE=
# Where the directory is read from: auto (Supabase first, then sheet) | supabase | sheet.
# Prefer `auto` after importing the roster into Supabase. No demo fallback.
SAFEX_EMPLOYEE_DIRECTORY_SOURCE=auto
# Which tenant the roster belongs to. Required by the importer and by Supabase lookups
# until verified tenant_domains rows drive host-based resolution.
SAFEX_TENANT_SLUG=YOUR_TENANT_SLUG
# Public company name shown on the Employee Safety Passport when the database cannot answer
# (snapshot sources or an outage). `tenants.company_name` wins whenever it is available.
SAFEX_TENANT_COMPANY_NAME=
# Every row is mapped to this site when the sheet has no Site column. Use the site's
# `sites.slug` value: the provisioned West Bokaro site slug is `wbd`.
SAFEX_EMPLOYEE_MASTER_SITE_ID=wbd
SAFEX_EMPLOYEE_MASTER_SITE_NAME=West Bokaro (WBD)
SAFEX_EMPLOYEE_MASTER_SITE_REGION=Ghatotand, Ramgarh
# How long a loaded roster is cached in server memory before it is re-read.
SAFEX_EMPLOYEE_MASTER_TTL_SECONDS=600
# Employee Safety Passport: release the Safety Pass No. in the public lookup (default off).
# This is a credential, so enable it only with company approval. Mobile number, blood group,
# address and date of birth are never released by this flag.
SAFEX_PUBLIC_SAFETY_PASS=false

# Optional push setup. Keep the private key server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Admin / safety-officer console -------------------------------------------------
# Sign-in accepts either credential pair, both checked server-side:
#   1. The demo username/password shown in the login dialog — constants in
#      lib/admin-credentials.ts. This is the default for the current frontend-to-backend
#      hookup phase; it is public and must be replaced by Supabase Auth + staff roles
#      before real users.
#   2. SAFEX_ADMIN_PASSCODE — an operator-only shared credential that lives only here.
#      12 characters minimum. Never prefix with NEXT_PUBLIC_. Leave it empty to rely on
#      the demo credentials only.
SAFEX_ADMIN_PASSCODE=
# Optional. Signs the session cookie. When unset: derived from the passcode (rotating
# the passcode invalidates every live session), or a built-in dev secret when only the
# demo credentials are in use.
SAFEX_ADMIN_SESSION_SECRET=
# Release safety pass number, registered mobile and blood group to verified officers.
# Separate from sign-in on purpose: blood group is health data and a home address can put
# someone at risk, so reading them is its own explicit decision.
SAFEX_ADMIN_PII_ENABLED=false
